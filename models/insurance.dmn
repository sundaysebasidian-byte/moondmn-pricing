<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="insurance_pricing" name="Insurance Pricing"
             namespace="urn:moondmn-pricing:insurance"
             exporter="moondmn-pricing contributors" exporterVersion="0.1.0">
  <inputData id="input_age" name="age"><variable name="age" typeRef="number"/></inputData>
  <inputData id="input_claims" name="claims"><variable name="claims" typeRef="number"/></inputData>
  <inputData id="input_value" name="insuredValue"><variable name="insuredValue" typeRef="number"/></inputData>
  <inputData id="input_monthly" name="paymentMonthly"><variable name="paymentMonthly" typeRef="boolean"/></inputData>
  <inputData id="input_start" name="startDate"><variable name="startDate" typeRef="date"/></inputData>

  <businessKnowledgeModel id="bkm_base" name="annualBase">
    <variable name="annualBase"/>
    <encapsulatedLogic kind="FEEL">
      <formalParameter name="value" typeRef="number"/>
      <formalParameter name="rate" typeRef="number"/>
      <literalExpression><text>decimal(value * rate, 2)</text></literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>

  <decision id="risk" name="Risk">
    <variable name="Risk"/>
    <informationRequirement><requiredInput href="#input_age"/></informationRequirement>
    <informationRequirement><requiredInput href="#input_claims"/></informationRequirement>
    <decisionTable hitPolicy="FIRST">
      <input label="Prior claims"><inputExpression typeRef="number"><text>claims</text></inputExpression></input>
      <input label="Driver age"><inputExpression typeRef="number"><text>age</text></inputExpression></input>
      <output name="tier" typeRef="string"/>
      <output name="rate" typeRef="number"/>
      <rule id="risk_claims"><inputEntry><text>&gt;= 3</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>"high"</text></outputEntry><outputEntry><text>0.04</text></outputEntry></rule>
      <rule id="risk_young"><inputEntry><text>-</text></inputEntry><inputEntry><text>&lt; 25</text></inputEntry><outputEntry><text>"young"</text></outputEntry><outputEntry><text>0.03</text></outputEntry></rule>
      <rule id="risk_senior"><inputEntry><text>-</text></inputEntry><inputEntry><text>&gt;= 65</text></inputEntry><outputEntry><text>"senior"</text></outputEntry><outputEntry><text>0.025</text></outputEntry></rule>
      <rule id="risk_standard"><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>"standard"</text></outputEntry><outputEntry><text>0.02</text></outputEntry></rule>
    </decisionTable>
  </decision>

  <decision id="base" name="BasePremium">
    <variable name="BasePremium" typeRef="number"/>
    <informationRequirement><requiredDecision href="#risk"/></informationRequirement>
    <informationRequirement><requiredInput href="#input_value"/></informationRequirement>
    <knowledgeRequirement><requiredKnowledge href="#bkm_base"/></knowledgeRequirement>
    <literalExpression><text>annualBase(insuredValue, Risk.rate)</text></literalExpression>
  </decision>

  <decision id="surcharges" name="Surcharges">
    <variable name="Surcharges" typeRef="number"/>
    <informationRequirement><requiredInput href="#input_claims"/></informationRequirement>
    <informationRequirement><requiredInput href="#input_monthly"/></informationRequirement>
    <informationRequirement><requiredInput href="#input_value"/></informationRequirement>
    <decisionTable hitPolicy="COLLECT" aggregation="SUM">
      <input label="Claims"><inputExpression typeRef="number"><text>claims</text></inputExpression></input>
      <input label="Monthly payment"><inputExpression typeRef="boolean"><text>paymentMonthly</text></inputExpression></input>
      <input label="Insured value"><inputExpression typeRef="number"><text>insuredValue</text></inputExpression></input>
      <output typeRef="number"><defaultOutputEntry><text>0</text></defaultOutputEntry></output>
      <rule id="fee_claims"><inputEntry><text>&gt;= 1</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>50</text></outputEntry></rule>
      <rule id="fee_monthly"><inputEntry><text>-</text></inputEntry><inputEntry><text>true</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>24</text></outputEntry></rule>
      <rule id="fee_value"><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>&gt; 50000</text></inputEntry><outputEntry><text>100</text></outputEntry></rule>
    </decisionTable>
  </decision>

  <decision id="premium" name="AnnualPremium">
    <variable name="AnnualPremium" typeRef="number"/>
    <informationRequirement><requiredDecision href="#base"/></informationRequirement>
    <informationRequirement><requiredDecision href="#surcharges"/></informationRequirement>
    <literalExpression><text>decimal(sum([BasePremium, Surcharges]), 2)</text></literalExpression>
  </decision>

  <decision id="quote" name="Quote">
    <variable name="Quote"/>
    <informationRequirement><requiredDecision href="#risk"/></informationRequirement>
    <informationRequirement><requiredDecision href="#base"/></informationRequirement>
    <informationRequirement><requiredDecision href="#surcharges"/></informationRequirement>
    <informationRequirement><requiredDecision href="#premium"/></informationRequirement>
    <informationRequirement><requiredInput href="#input_start"/></informationRequirement>
    <literalExpression><text>{risk: Risk.tier, basePremium: BasePremium, surcharges: Surcharges, annualPremium: AnnualPremium, validUntil: startDate + duration("P30D"), coverageEnd: startDate + duration("P1Y")}</text></literalExpression>
  </decision>
</definitions>
